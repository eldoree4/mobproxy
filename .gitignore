# ======================
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# ======================
# Go workspace
# ======================
go.work
go.work.sum

# ======================
# Runtime data (DO NOT COMMIT)
# ======================
projects/
history/
cache/
tmp/
temp/
.session/
workspace/
output/
results/

# ======================
# Certificates & secrets
# ======================
certs/*.key
certs/*.pem
certs/*.crt
certs/*.p12

# ======================
# Logs
# ======================
*.log
logs/

# ======================
# Payload & wordlists (optional)
